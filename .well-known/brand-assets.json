{
  "$schema": "https://json.schemastore.org/brand-assets",
  "brand": "EPD Commerce",
  "brand_type": "product",
  "parent_brand": "Easy Pay Direct",
  "legal": "EPD Commerce is a DBA of Easy Pay Direct LLC.",
  "version": "3.0",
  "updated": "2026-10-15",
  "repository": "https://github.com/EasyPayDirect/epd-commerce-brand",
  "site": "https://epd.com",
  "read_first": {
    "names": "data/names.json",
    "claims": "data/claims.json",
    "templates": "templates/",
    "payment_options": "messaging-kit/payment-options.md",
    "capabilities": "messaging-kit/capabilities/",
    "features": "messaging-kit/features/",
    "guidelines": "brand-guidelines/"
  },
  "identity": {
    "primary_line": "Built to accept payments from humans and agents.",
    "messaging_hierarchy": [
      "Accept payments",
      "Two processing options: Process Now and Easy Pay Direct",
      "Tools built on top: Transact, React, Analyze, Create"
    ],
    "ai_audience_lines": [
      "Most AI helps you write faster. EPD Commerce helps you run better.",
      "Agentic inside and out."
    ],
    "ai_audience_rule": "Use AI-first lines only for AI-focused audiences. Lead with payments everywhere else.",
    "supporting_lines": [
      "Same platform. Same dashboard. Same catalog.",
      "Change rails without changing how you operate.",
      "Most platforms tell you a payment failed. EPD Commerce does something about it."
    ],
    "capabilities": [
      "Transact",
      "React",
      "Analyze",
      "Create"
    ],
    "capabilities_rule": "Approved only with their explanation. See messaging-kit/capabilities/.",
    "voice": "Confident, plainspoken, grounded. Short declarative sentences. Talk to you and your business. No hype, no hedging, no exclamation points, no em dashes."
  },
  "tokens": {
    "color": {
      "page": "#FFFFFF",
      "pale": "#EBEDF6",
      "tint": "#F5F7FC",
      "border": "#E2E8F0",
      "button_blue": "#00499A",
      "link_blue": "#0056BB",
      "link_hover": "#003C7E",
      "sky_accent": "#8DCAFF",
      "sky_eyebrow": "#87C5FF",
      "text_on_light": {
        "headline": "#0E1422",
        "body": "#4A5878",
        "muted": "#64748B"
      },
      "text_on_dark": {
        "headline": "#FFFFFF",
        "strong": "#EBEDF6",
        "body": "#D1D8E7",
        "muted": "#8FA0BF"
      },
      "semantic": {
        "status_green": "#3DDC73",
        "up_delta": "#0E9F5A",
        "error": "#B91C1C"
      },
      "semantic_rule": "Green is for in-product status and diagrams only. Never a marketing accent."
    },
    "surfaces": {
      "dark_gradient": "linear-gradient(100deg, #002B55 0%, #001D3B 55%, #000E20 100%)",
      "dark_highlight": "radial-gradient(60% 80% at 78% 45%, rgba(40,120,220,.28), transparent 70%)",
      "dark_panel_radius_px": 20,
      "rule": "Dark sections are rounded panels on a white page. Never fade to white.",
      "social_gradient": "linear-gradient(135deg, #004A9C 0%, #003C7E 45%, #001D3B 100%)",
      "social_glow": "radial-gradient(circle at 90% 5%, rgba(0,104,222,.75), rgba(0,87,194,0) 75%)",
      "social_rule": "Brighter gradient for social and partner graphics. White cards may sit on it."
    },
    "shadow": {
      "elevated": "0 24px 60px -24px rgba(0,30,80,.35), 0 6px 20px -10px rgba(0,30,80,.18)",
      "card": "0 8px 24px -14px rgba(20,30,60,.18)",
      "rule": "Selective: elevated cards, diagrams, screenshots, nav pill. Never on text or logos. No glows."
    },
    "radius_px": {
      "button": 4,
      "card": 16,
      "panel": 20,
      "screenshot": 12
    },
    "font": {
      "sans": {
        "family": "General Sans",
        "fallback": "DM Sans, Inter, system-ui, sans-serif",
        "source": "https://fontshare.com/fonts/general-sans"
      },
      "mono": {
        "family": "DM Mono",
        "fallback": "JetBrains Mono, Menlo, monospace",
        "source": "https://fonts.google.com/specimen/DM+Mono"
      }
    }
  },
  "components": {
    "hero_headline": {
      "font": "General Sans",
      "weight": 500,
      "size_px": 38,
      "size_tablet_px": 34,
      "size_mobile_px": 30,
      "line_height": 1.12,
      "tracking": "-0.025em",
      "color": "#FFFFFF"
    },
    "feature_headline_dark": {
      "font": "General Sans",
      "weight": 540,
      "size_px": 60,
      "line_height": 0.98,
      "tracking": "-0.052em",
      "color": "#FFFFFF",
      "accent_line_color": "#8DCAFF"
    },
    "section_headline_light": {
      "font": "General Sans",
      "weight": 500,
      "size_px": 40,
      "tracking": "-1px",
      "color": "#0E1422"
    },
    "body": {
      "font": "General Sans",
      "weight": 400,
      "size_px": 16,
      "line_height": 1.6
    },
    "eyebrow": {
      "font": "DM Mono",
      "weight": 500,
      "size_px": [
        12,
        14
      ],
      "tracking": "0.12em to 0.16em",
      "case": "uppercase",
      "color_light": "#0056BB",
      "color_dark": "#87C5FF"
    },
    "button_primary": {
      "font": "DM Mono",
      "weight": 500,
      "size_px": 14,
      "tracking": "0.42px",
      "case": "uppercase",
      "radius_px": 4,
      "on_light": {
        "fill": "#00499A",
        "text": "#FFFFFF"
      },
      "on_dark": {
        "fill": "#FFFFFF",
        "text": "#00499A"
      }
    },
    "button_secondary": {
      "font": "DM Mono",
      "weight": 500,
      "size_px": 14,
      "tracking": "0.42px",
      "case": "uppercase",
      "radius_px": 4,
      "on_light": {
        "fill": "transparent",
        "border": "1px #00499A",
        "text": "#00499A"
      },
      "on_dark": {
        "fill": "transparent",
        "border": "1px #FFFFFF",
        "text": "#FFFFFF"
      }
    },
    "link_cta": {
      "font": "DM Mono",
      "weight": 500,
      "size_px": 14,
      "tracking": "0.06em",
      "case": "uppercase",
      "color": "#0056BB",
      "hover": "#003C7E",
      "suffix": "→"
    },
    "nav": {
      "style": "Dark navy pill with soft shadow. Outline CTA (GET ACCESS)."
    }
  },
  "assets": {
    "_partner_use_values": {
      "approved": "Partners may use inside studio templates.",
      "pending": "EPD Commerce use only until approved.",
      "no": "Never in partner graphics."
    },
    "logos": [
      {
        "path": "assets/logos/epdc-horizontal-white.png",
        "use": "Primary lockup on dark. Transparent.",
        "backgrounds": [
          "dark gradient",
          "navy"
        ],
        "cropping": "Never crop.",
        "partner_use": "approved"
      },
      {
        "path": "assets/logos/epdc-horizontal-navy-on-light.png",
        "use": "Primary lockup on light.",
        "backgrounds": [
          "white",
          "pale",
          "tint"
        ],
        "cropping": "Never crop.",
        "partner_use": "approved"
      },
      {
        "path": "assets/logos/epdc-horizontal-on-navy.png",
        "use": "Lockup on a solid navy tile.",
        "backgrounds": [
          "any, as a tile"
        ],
        "cropping": "Never crop.",
        "partner_use": "approved"
      },
      {
        "path": "assets/logos/epdc-horizontal.svg",
        "use": "Source vector for print and large sizes.",
        "backgrounds": [
          "dark"
        ],
        "cropping": "Never crop.",
        "partner_use": "approved"
      },
      {
        "path": "assets/logos/epdc-stacked.png",
        "use": "Square or narrow vertical spaces.",
        "backgrounds": [
          "white",
          "pale"
        ],
        "cropping": "Never crop.",
        "partner_use": "approved"
      },
      {
        "path": "assets/logos/epdc-mark-on-dark.svg",
        "use": "Standalone diamond mark. White diamond, navy EPD.",
        "backgrounds": [
          "dark gradient",
          "navy"
        ],
        "cropping": "Never crop.",
        "partner_use": "approved",
        "min_px": 24
      },
      {
        "path": "assets/logos/epdc-mark-on-light.svg",
        "use": "Standalone diamond mark. Navy diamond, white EPD.",
        "backgrounds": [
          "white",
          "pale"
        ],
        "cropping": "Never crop.",
        "partner_use": "approved",
        "min_px": 24
      },
      {
        "path": "assets/logos/process-now-white.png",
        "use": "Process Now logo. Only where the two options are explained.",
        "backgrounds": [
          "dark"
        ],
        "cropping": "Never crop.",
        "partner_use": "approved",
        "templates": [
          "two-payment-options"
        ]
      },
      {
        "path": "assets/logos/easy-pay-direct-white.png",
        "use": "Easy Pay Direct logo. Only where the two options are explained.",
        "backgrounds": [
          "dark"
        ],
        "cropping": "Never crop.",
        "partner_use": "approved",
        "templates": [
          "two-payment-options"
        ]
      }
    ],
    "payment_methods": {
      "folder": "assets/payment-methods/",
      "sources": "assets/payment-methods/SOURCES.md",
      "use": "Show the ways buyers can pay. Real marks only.",
      "backgrounds": [
        "dark gradient (white single-color)",
        "white (each brand's allowed color)"
      ],
      "cropping": "Never crop or alter.",
      "partner_use": "pending",
      "note": "Simple Icons versions match the site. Replace with brand-owner marks before partner use. Each brand's own guidelines apply."
    },
    "diagrams": [
      {
        "path": "assets/diagrams/foundation-diagram.png",
        "use": "Foundation diagram: one platform layer over Process Now and Easy Pay Direct.",
        "backgrounds": [
          "dark"
        ],
        "cropping": "Use as is. Never crop through a card.",
        "partner_use": "approved",
        "note": "Marketing artwork, not a product screenshot."
      },
      {
        "path": "assets/diagrams/foundation-section.png",
        "use": "Full Foundation section artwork with headline, copy, and logo (1600x1000).",
        "backgrounds": [
          "n/a"
        ],
        "cropping": "Use whole, or use foundation-diagram.png for the diagram alone.",
        "partner_use": "approved"
      },
      {
        "path": "assets/diagrams/foundation-section.svg",
        "use": "Source vector for the Foundation section.",
        "backgrounds": [
          "n/a"
        ],
        "cropping": "n/a",
        "partner_use": "no",
        "note": "Text renders correctly only with General Sans and DM Mono installed. Use the PNG for predictable output."
      }
    ],
    "screenshots": {
      "folder": "assets/epd-commerce-features/",
      "index": "messaging-kit/features/<slug>.md images block",
      "use": "Product spotlight template and blog bodies.",
      "backgrounds": [
        "dark gradient",
        "white"
      ],
      "cropping": "Scale to fit. Crop only to a whole panel or card. Never crop through text or numbers, never edit UI.",
      "partner_use": "approved",
      "note": "Numbers in screenshots are sample data and are never claims."
    },
    "backgrounds": [
      {
        "path": "assets/backgrounds/dark-gradient-{story,square,landscape}.png",
        "use": "Default dark background for templates.",
        "backgrounds": [
          "n/a"
        ],
        "cropping": "Use at native size.",
        "partner_use": "approved"
      },
      {
        "path": "assets/backgrounds/dark-gradient-highlight-{story,square,landscape}.png",
        "use": "Dark background with soft blue highlight behind imagery.",
        "backgrounds": [
          "n/a"
        ],
        "cropping": "Use at native size.",
        "partner_use": "approved"
      },
      {
        "path": "assets/backgrounds/social-gradient-{story,square,landscape}.png",
        "use": "Social and partner graphics.",
        "backgrounds": [
          "n/a"
        ],
        "cropping": "Use at native size.",
        "partner_use": "approved"
      }
    ],
    "motif": [
      {
        "path": "assets/motif/hero-diamonds.svg",
        "use": "Cascading diamond motif. Decorative.",
        "backgrounds": [
          "dark"
        ],
        "cropping": "May bleed off an edge. Never behind body text.",
        "partner_use": "approved"
      },
      {
        "path": "assets/motif/side-diamonds.svg",
        "use": "Side-panel diamond motif from the site.",
        "backgrounds": [
          "dark"
        ],
        "cropping": "May bleed off an edge. Never behind body text.",
        "partner_use": "approved"
      }
    ],
    "examples": [
      {
        "path": "assets/examples/story-process-now.png",
        "source": "assets/examples/story-process-now.svg",
        "use": "Finished Process Now story. Reference for the two payment options and payments benefit families.",
        "partner_use": "approved"
      },
      {
        "path": "assets/examples/story-easy-pay-direct.png",
        "source": "assets/examples/story-easy-pay-direct.svg",
        "use": "Finished Easy Pay Direct story. Eyebrow 'MERCHANT ACCOUNTS' is an approved contextual label.",
        "partner_use": "approved"
      }
    ]
  },
  "image_generation_rules": [
    "Composite logos, marks, motifs, diagrams, and screenshots from this repo. Never generate or redraw them.",
    "AI illustrations only inside a template's image area, and only in families that allow them.",
    "Illustrations contain no text, numbers, logos, payment marks, card brands, or UI."
  ]
}
